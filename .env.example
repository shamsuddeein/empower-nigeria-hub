# -----------------------------------------------------------------------------
# S.i and Billionaires Hub Nig.Ltd - Environment Configuration Example
# -----------------------------------------------------------------------------

# Turso (libSQL) Database Configuration
# Local development: file:local.db (default if unset)
# Production: libsql://your-database-name-organization.turso.io
TURSO_DATABASE_URL="file:local.db"
# Turso authentication token (required for hosted Turso instances)
TURSO_AUTH_TOKEN=""

# Better Auth Configuration
# Secret key used for signing session tokens and internal security (minimum 32 characters)
BETTER_AUTH_SECRET="si-and-billionaires-hub-dev-secret-32-chars-long"
# Base URL of the deployment (e.g. http://localhost:3000 or https://billionaireshub.ng)
BETTER_AUTH_URL="http://localhost:3000"
# Trusted origins (comma-separated if multiple)
TRUSTED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Staff Bootstrap (Optional environment variables for `npm run staff:bootstrap`)
# STAFF_EMAIL="admin@billionaireshub.ng"
# STAFF_PASSWORD="your-secure-admin-password"
# STAFF_NAME="Staff Administrator"
